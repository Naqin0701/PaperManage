#!/usr/bin/env python3
"""Crossref/arXiv metadata plugin for PaperManage.

Speaks JSON-RPC 2.0 over stdio, one JSON object per line. Logs go to stderr.
"""
import json
import re
import sys
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

PROTOCOL = "papermgr-plugin/v1"
CONFIG = {}


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def http_json(url, timeout=12):
    req = urllib.request.Request(url, headers={
        "User-Agent": "papermgr-crossref/0.1 (mailto:%s)" % CONFIG.get("mailto", "user@example.com"),
        "Accept": "application/json",
    })
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def http_text(url, timeout=12):
    req = urllib.request.Request(url, headers={
        "User-Agent": "papermgr-crossref/0.1 (mailto:%s)" % CONFIG.get("mailto", "user@example.com"),
    })
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8")


def strip_jats(s):
    if not s:
        return ""
    s = re.sub(r"<[^>]+>", " ", s)
    return re.sub(r"\s+", " ", s).strip()


def year_of(item):
    for key in ("issued", "published-print", "published-online", "created"):
        parts = (item.get(key) or {}).get("date-parts")
        if parts and parts[0] and parts[0][0]:
            return int(parts[0][0])
    return 0


def crossref_fields(item):
    typ = item.get("type", "")
    entry = {
        "journal-article": "article",
        "proceedings-article": "inproceedings",
        "book-chapter": "incollection",
        "book": "book",
        "dissertation": "phdthesis",
        "report": "techreport",
        "posted-content": "preprint",
    }.get(typ, "misc")
    kind = "journal" if typ == "journal-article" else ("conference" if typ == "proceedings-article" else "other")
    authors = []
    for a in item.get("author", []) or []:
        authors.append({
            "given": a.get("given", ""),
            "family": a.get("family", ""),
            "orcid": a.get("ORCID"),
            "affiliation": [x.get("name", "") for x in a.get("affiliation", []) if x.get("name")],
        })
    title = (item.get("title") or [""])[0]
    container = (item.get("container-title") or [""])[0]
    short = (item.get("short-container-title") or [""])[0]
    fields = {
        "title": title,
        "authors": authors,
        "year": year_of(item),
        "entry_type": entry,
        "doi": item.get("DOI", ""),
        "url": item.get("URL", ""),
        "abstract": strip_jats(item.get("abstract", "")),
        "keywords": item.get("subject", []) or [],
        "language": item.get("language", ""),
        "venue": {
            "name": container,
            "short": short,
            "kind": kind,
            "volume": item.get("volume"),
            "issue": item.get("issue"),
            "pages": item.get("page"),
            "publisher": item.get("publisher"),
        },
    }
    return {k: v for k, v in fields.items() if v not in (None, "", [], {})}


def fetch_crossref_doi(doi):
    url = "https://api.crossref.org/works/" + urllib.parse.quote(doi, safe="")
    data = http_json(url)
    item = data.get("message", {})
    return item


def fetch_crossref_title(title, year):
    q = urllib.parse.urlencode({"query.bibliographic": title, "rows": "3"})
    if year:
        q += "&filter=from-pub-date:%d-01-01,until-pub-date:%d-12-31" % (year, year)
    data = http_json("https://api.crossref.org/works?" + q)
    return (data.get("message", {}).get("items") or [])[:3]


def fetch_arxiv(arxiv_id):
    url = "http://export.arxiv.org/api/query?id_list=" + urllib.parse.quote(arxiv_id)
    xml = http_text(url)
    ns = {"a": "http://www.w3.org/2005/Atom", "arxiv": "http://arxiv.org/schemas/atom"}
    root = ET.fromstring(xml)
    entry = root.find("a:entry", ns)
    if entry is None:
        return None
    title = re.sub(r"\s+", " ", (entry.findtext("a:title", default="", namespaces=ns) or "")).strip()
    abstract = re.sub(r"\s+", " ", (entry.findtext("a:summary", default="", namespaces=ns) or "")).strip()
    authors = []
    for a in entry.findall("a:author", ns):
        name = (a.findtext("a:name", default="", namespaces=ns) or "").strip()
        if not name:
            continue
        parts = name.split()
        authors.append({"given": " ".join(parts[:-1]), "family": parts[-1], "orcid": None, "affiliation": []})
    published = entry.findtext("a:published", default="", namespaces=ns) or ""
    year = int(published[:4]) if published[:4].isdigit() else 0
    doi = entry.findtext("arxiv:doi", default="", namespaces=ns) or ""
    journal = entry.findtext("arxiv:journal_ref", default="", namespaces=ns) or ""
    return {
        "title": title,
        "authors": authors,
        "year": year,
        "entry_type": "preprint" if not journal else "article",
        "doi": doi or ("10.48550/arXiv." + arxiv_id),
        "arxiv_id": arxiv_id,
        "url": "https://arxiv.org/abs/" + arxiv_id,
        "abstract": abstract,
        "venue": {"name": journal or "arXiv", "short": "arXiv", "kind": "other"},
    }


def similarity(a, b):
    at = set(re.findall(r"[a-z0-9]+", (a or "").lower()))
    bt = set(re.findall(r"[a-z0-9]+", (b or "").lower()))
    if not at or not bt:
        return 0.0
    return len(at & bt) / float(len(at | bt))


def metadata_fetch(params):
    hints = params.get("hints") or {}
    doi = (hints.get("doi") or "").strip()
    arxiv = (hints.get("arxiv_id") or "").strip()
    title_guess = (hints.get("title_guess") or hints.get("filename") or "").strip()
    year = hints.get("year") or 0
    candidates = []

    if not arxiv and doi.startswith("10.48550/arXiv."):
        arxiv = doi.split("arXiv.")[-1]

    if arxiv:
        try:
            fields = fetch_arxiv(arxiv)
            if fields:
                candidates.append({"fields": fields, "confidence": 0.95, "source": "arxiv"})
        except Exception as e:  # noqa: BLE001
            log("arxiv lookup failed: %s" % e)

    if doi and not doi.startswith("10.48550/"):
        try:
            item = fetch_crossref_doi(doi)
            fields = crossref_fields(item)
            if fields:
                candidates.append({"fields": fields, "confidence": 0.97, "source": "crossref"})
        except Exception as e:  # noqa: BLE001
            log("crossref DOI lookup failed: %s" % e)

    if not candidates and title_guess:
        try:
            for item in fetch_crossref_title(title_guess, year):
                fields = crossref_fields(item)
                if not fields.get("title"):
                    continue
                conf = similarity(title_guess, fields["title"])
                if year and fields.get("year") and abs(int(fields["year"]) - int(year)) <= 1:
                    conf += 0.1
                conf = max(0.2, min(0.9, conf))
                candidates.append({"fields": fields, "confidence": round(conf, 2), "source": "crossref"})
        except Exception as e:  # noqa: BLE001
            log("crossref title search failed: %s" % e)

    candidates.sort(key=lambda c: c["confidence"], reverse=True)
    return {"candidates": candidates[:3]}


def dispatch(req):
    method = req.get("method")
    params = req.get("params") or {}
    if method == "init":
        global CONFIG
        CONFIG = params.get("config") or {}
        return {"ok": True, "protocol": PROTOCOL}
    if method == "health":
        return {"ok": True, "missing": []}
    if method == "metadata.fetch":
        return metadata_fetch(params)
    raise ValueError("unsupported method: %s" % method)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
            result = dispatch(req)
            resp = {"jsonrpc": "2.0", "id": req.get("id"), "result": result}
        except Exception as e:  # noqa: BLE001
            log("error: %s" % e)
            resp = {"jsonrpc": "2.0", "id": None, "error": {"code": -32000, "message": str(e)}}
        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
